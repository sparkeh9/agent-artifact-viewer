{
  "identifier": "default",
  "description": "Default capabilities of this application",
  "local": true,
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "cli:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "name": "open",
          "args": [
            {
              "validator": ".*"
            }
          ]
        }
      ]
    },
    "shell:allow-execute"
  ]
}
